# Copy to .env and fill in for local development. Never commit the real .env.
# Values here match docker-compose.dev.yml's defaults.

# --- ClickHouse (event lake) ---
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=attesta
CLICKHOUSE_USER=attesta
CLICKHOUSE_PASSWORD=attesta-dev

# --- PostgreSQL (control plane) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=attesta
POSTGRES_USER=attesta
POSTGRES_PASSWORD=attesta-dev

# --- NATS JetStream (bus) ---
NATS_URL=nats://localhost:4222

# --- Valkey (cache/queue) ---
VALKEY_URL=redis://localhost:6379

# --- SeaweedFS (local S3-compatible object store) ---
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Inference provider (services/investigate — wired in Phase 6) ---
# provider: vllm | ollama | anthropic | openai | azure | bedrock
INFERENCE_PROVIDER=vllm
INFERENCE_ENDPOINT=
INFERENCE_API_KEY=
